{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["src/*"],
      "@yapilapi/api-client": ["../../packages/api-client/src/index.ts"],
      "@yapilapi/api-client/*": ["../../packages/api-client/src/*"],
      "@yapilapi/design-system": ["../../packages/design-system/src/index.ts"],
      "@yapilapi/design-system/*": ["../../packages/design-system/src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "*.ts",
    "*.tsx",
    "expo-env.d.ts",
    "../../packages/api-client/src/*.ts",
    "../../packages/design-system/src/*.ts"
  ],
  "exclude": ["node_modules", "../../packages/**/*.test.ts", "test/support/*.mts"]
}
