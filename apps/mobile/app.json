{
  "expo": {
    "name": "YAPILAPI",
    "slug": "yapilapi",
    "scheme": "yapilapi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yapilapi.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "YAPILAPI uses the camera for video calls and to capture Reals.",
        "NSMicrophoneUsageDescription": "YAPILAPI uses the microphone for audio and video calls.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.yapilapi.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "YAPILAPI uses the camera for video calls and to capture Reals.",
          "microphonePermission": "YAPILAPI uses the microphone for audio and video calls.",
          "recordAudioAndroid": true
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "YAPILAPI uses the camera for video calls and to capture Reals.",
          "microphonePermission": "YAPILAPI uses the microphone for audio and video calls."
        }
      ],
      "expo-dev-client",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "fr", "ar", "es", "pt", "sw", "yo", "ha"]
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": ""
      }
    }
  }
}
