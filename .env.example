# Copy to .env and adjust. Never commit real secrets. An empty value counts as unset (the default applies).

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
# development | staging | production
APP_ENV=development

# --- API ---------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the web app, used for CORS and cookie settings
WEB_ORIGIN=http://localhost:3000

# --- Database (docker compose provides these defaults) -----------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yapilapi
# Used only by the test suite; created automatically by the test setup
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/yapilapi_test

# --- Redis (rate limiting, realtime fan-out) ---------------------------
# Leave empty to fall back to in-memory (single instance only)
REDIS_URL=redis://localhost:6379

# --- Sessions ----------------------------------------------------------
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to true behind HTTPS (staging/production)
COOKIE_SECURE=false

# --- Two-step verification --------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts TOTP secrets.
# Required in production; development uses a fixed dev key when empty.
MFA_ENCRYPTION_KEY=

# --- Email (verification, password reset) -------------------------------
# "log" prints emails to the API log in development. "smtp" sends them through
# SMTP_URL (nodemailer), e.g. smtps://user:password@smtp.example.com:465.
# Production refuses to start without smtp. MISSING EXTERNAL DEPENDENCY: SMTP account.
EMAIL_TRANSPORT=log
SMTP_URL=
EMAIL_FROM="YAPILAPI <no-reply@yapilapi.local>"

# --- Media storage -------------------------------------------------------
# local = ./uploads on disk. s3 = any S3-compatible store (AWS S3, R2, MinIO,
# SeaweedFS). docker compose runs SeaweedFS on :8333 for development.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=yapilapi-media
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
# Digital products people sell (PDFs, zips, audio) are stored apart from public
# media and only served to buyers through short-lived download links. With
# STORAGE_DRIVER=local they go in this folder; with s3 they go under private/
# in the bucket, which /media/ never serves.
PRIVATE_UPLOAD_DIR=./uploads-private

# --- Calls (WebRTC) ---------------------------------------------------------
# STUN is built in. MISSING EXTERNAL DEPENDENCY: a TURN server for users behind
# strict NATs (e.g. coturn or a hosted TURN service).
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=dev-turn-secret

# --- Push notifications ---------------------------------------------------
# Browser push (VAPID). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yapilapi.local

# --- Passkeys ------------------------------------------------------------------
# Defaults to the host of WEB_ORIGIN. Set to your real domain in production.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# --- Live video (MediaMTX in docker compose) -----------------------------------
LIVE_RTMP_URL=rtmp://localhost:1935
LIVE_HLS_BASE=http://localhost:8888
# MediaMTX control API; ending a live then disconnects the encoder.
LIVE_CONTROL_URL=http://localhost:9997
# Where MediaMTX records lives (docker-compose mounts it); absolute, or relative to apps/api. Empty turns off recordings and auto-clips.
LIVE_RECORDINGS_DIR=../../infrastructure/media/recordings
# Must match the ?secret= in infrastructure/media/mediamtx.yml
LIVE_HOOK_SECRET=dev-live-hook-secret

# --- Event tickets ---------------------------------------------------------------
# Signs the token in each ticket's QR code. Empty uses a fixed dev secret; production needs 32+ random characters.
TICKET_TOKEN_SECRET=

# --- AI (provider-agnostic gateway) -------------------------------------
# dev = deterministic local provider (no network). anthropic = Claude API.
AI_PROVIDER=dev
AI_MODEL=claude-opus-5
# Translations only (posts, comments, stories, messages, caption tracks): many short requests.
AI_TRANSLATE_MODEL=claude-sonnet-5-5
# Automatic translation: new translations per person per hour, and per day for everyone (then "See translation").
AUTO_TRANSLATE_PER_HOUR=200
AUTO_TRANSLATE_DAILY_LIMIT=20000
# MISSING EXTERNAL DEPENDENCY: API key for the chosen provider
ANTHROPIC_API_KEY=

# --- Automatic captions (speech-to-text) ---------------------------------
# none = automatic captions are unavailable (people can still write or upload
# captions). openai-compatible = any POST {url}/audio/transcriptions service
# that returns WebVTT (OpenAI, Groq, a self-hosted Whisper server).
# MISSING EXTERNAL DEPENDENCY: a speech-to-text provider.
TRANSCRIBE_PROVIDER=none
TRANSCRIBE_API_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
# Recommended in production: Groq (TRANSCRIBE_API_URL=https://api.groq.com/openai/v1,
# TRANSCRIBE_MODEL=whisper-large-v3-turbo). Also transcribes chat voice messages.

# Text-to-speech: "Listen in French" under a translated voice message. Any service with
# the OpenAI-compatible POST {TTS_API_URL}/audio/speech (OpenAI gpt-4o-mini-tts or tts-1).
# Off ('none') unless configured; there is no stand-in voice.
TTS_PROVIDER=none
TTS_API_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Optional voices per language: TTS_VOICES=fr=nova,ar=onyx
TTS_VOICES=
TTS_DAILY_CHAR_LIMIT=200000
TTS_PER_HOUR=30

# --- Account verification -------------------------------------------------
# When true, posting publicly, messaging people who aren't friends yet and going
# live need a confirmed email or phone number. Empty: true in production,
# false elsewhere (tests and local development sign up without confirming).
REQUIRE_VERIFICATION=
# Phone verification codes. dev = codes are written to the API log (and shown
# at /dev/sms-outbox in development). twilio = Twilio Verify sends and checks them.
# MISSING EXTERNAL DEPENDENCY: a Twilio account with a Verify service.
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Spam and bot detection ------------------------------------------------
# Sign-up risk signals (throwaway email domains, many sign-ups from one address
# or /24), stricter posting and messaging pace for accounts under 24 hours old,
# and repeated-text and link-spam checks. Empty: on everywhere except tests.
SPAM_CHECKS=

# --- Background workers ------------------------------------------------------
# Media processing, recap videos, scheduled posts, webhooks and room housekeeping
# run in the API process. Empty: on everywhere except APP_ENV=test (the API tests
# drive them directly); the accessibility audit sets it to true.
JOB_WORKER=

# --- Image and video moderation ---------------------------------------------
# Runs in the media processing job on photos and on video posters plus sampled
# frames. dev = offline rules for development and tests (a file name containing
# "blocked" is blocked; "sensitive" or "nsfw" is sensitive). rekognition = AWS
# Rekognition DetectModerationLabels. none = no automated checks.
# Empty: dev outside production, none in production.
# MISSING EXTERNAL DEPENDENCY: AWS credentials allowed to call rekognition:DetectModerationLabels.
MEDIA_MODERATION_PROVIDER=
REKOGNITION_REGION=us-east-1
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=
# Only for temporary credentials.
REKOGNITION_SESSION_TOKEN=

# --- Payments (provider abstraction) -------------------------------------
# dev = local sandbox provider. MISSING EXTERNAL DEPENDENCY: real provider keys.
PAYMENTS_PROVIDER=dev
PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Stripe (PAYMENTS_PROVIDER=stripe): secret key, webhook signing secret and the
# publishable key the browser uses. Webhook URL: {PUBLIC_API_URL}/v1/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Paystack (optional): set both keys to take NGN, GHS, KES and ZAR payments
# (cards, bank and mobile money) through Paystack's hosted checkout. Payments in
# other currencies stay with PAYMENTS_PROVIDER. Paystack signs webhooks with the
# secret key. Webhook URL: {PUBLIC_API_URL}/v1/payments/webhook/paystack
# MISSING EXTERNAL DEPENDENCY: a Paystack account.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# How many years payment, refund and payout records are kept (tax and accounting law; 7 by
# default). The daily clean-up deletes older ones. Confirm the period with your accountant.
FINANCIAL_RECORDS_YEARS=7
# --- Music catalogue (docs/operations/music.md) --------------------------
# In-app sounds are always on. Each outside source is off until its credentials are set.
# Jamendo (Creative Commons songs): a free client id from https://devportal.jamendo.com
# MISSING EXTERNAL DEPENDENCY: a Jamendo developer application.
JAMENDO_CLIENT_ID=
# A licensing partner's catalogue (mainstream music), once the business signs a deal.
# Both the address and the key, or neither. MISSING EXTERNAL DEPENDENCY: a licensing deal.
MUSIC_LICENSED_API_URL=
MUSIC_LICENSED_API_KEY=
MUSIC_LICENSED_NAME=Licensed catalogue
# Generated "[Dev data]" tones for development and tests (never on in production). false turns them off.
MUSIC_DEV_PROVIDER=

# YAPILAPI Plus: price of one month (30 days) in hundredths of the currency. Never renews on its own.
PLUS_PRICE_CENTS=499
PLUS_CURRENCY=USD

# How the phone apps offer digital goods: Plus, creator subscriptions, tips, boosts, downloads,
# tickets to lives (docs/operations/in-app-purchases.md). Physical products, services and event
# tickets keep their checkout whatever these say, and the web checkout always works.
# iPhone: hidden (default), external_link (link to the web checkout in the listed countries), iap.
IOS_DIGITAL_PURCHASES=hidden
IOS_EXTERNAL_LINK_COUNTRIES=US
# Android: play_billing_required (default, like hidden) or user_choice (link out in the listed countries).
ANDROID_DIGITAL_PURCHASES=play_billing_required
ANDROID_USER_CHOICE_COUNTRIES=US

# --- Tracing (OpenTelemetry) ---------------------------------------------
# Off when empty. Set to an OTLP/HTTP endpoint to export traces, e.g. the
# collector from `docker compose --profile tracing up -d` (UI: http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=yapilapi-api

# --- Web -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin of the web app for link previews (Open Graph), robots.txt and the sitemap.
# Defaults to WEB_ORIGIN, then to the host of each request.
SITE_URL=
# Extra origins (comma-separated) the web server may fetch images from when drawing share
# images, e.g. your S3 or CDN media host. The API origin is always allowed.
OG_IMAGE_ORIGINS=
# Who runs the service and how to reach them, shown on the legal pages (/legal). Read at request
# time by the web app. Until set, the pages show bracketed placeholders. See docs/operations/app-store.md.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
# Whose law governs the terms, as a phrase: "the laws of Nigeria"
LEGAL_JURISDICTION=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
COPYRIGHT_EMAIL=
SAFETY_EMAIL=

# Lets a monitoring service read /metrics with "Authorization: Bearer <token>". Empty: open in development, not served in production.
METRICS_TOKEN=
