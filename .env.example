# ---------------------------------------------------------------
# YAPILAPI environment. Copy to .env. NEVER commit real secrets.
# ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=development                # development | staging | production
APP_NAME=YAPILAPI

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (PostgreSQL 16+) ---
DATABASE_URL=postgres://yapilapi:yapilapi_dev_password@127.0.0.1:5432/yapilapi_dev
DATABASE_POOL_MAX=10

# --- Redis (realtime fan-out, rate limiting). Optional in development: falls back to in-memory ---
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets. REQUIRED in staging/production. Generate with: openssl rand -base64 48 ---
SESSION_COOKIE_NAME=yl_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                # true in staging/production
DATA_ENCRYPTION_KEY=               # base64, 32 bytes. Dev falls back to an ephemeral key with a warning.
DATA_ENCRYPTION_KEY_ID=k1
WEBHOOK_SIGNING_SECRET=            # dev payment provider webhook HMAC secret

# --- Email (adapter: console | smtp) ---
EMAIL_ADAPTER=console
SMTP_URL=
EMAIL_FROM=YAPILAPI <no-reply@example.invalid>

# --- Media / object storage (adapter: local | s3) ---
MEDIA_ADAPTER=local
MEDIA_LOCAL_DIR=./storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Binaries used for video/audio probing + transcoding. If missing, media is kept as-is (processing=passthrough).
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
CDN_BASE_URL=

# --- Payments (provider: dev | stripe) ---
PAYMENT_PROVIDER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=500               # 5.00%
STRIPE_API_BASE_URL=               # optional override (tests / proxies); default https://api.stripe.com
PAYOUT_HOLD_DAYS=7                 # days before a captured payment becomes payout-eligible
ORDER_RESERVATION_MINUTES=30       # stock reservation for unpaid orders
ORDER_REVIEW_HOLD_HOURS=48         # stock reservation for orders held for fraud review
PAYMENT_WEBHOOK_TOLERANCE_SEC=300  # max age/skew of a signed webhook
DOWNLOAD_URL_TTL_SEC=300           # lifetime of digital-product download links
ORDER_AUTO_COMPLETE_DAYS=14        # fulfilled orders auto-complete after this many days

# --- AI gateway (providers are optional; the built-in dev provider always works) ---
AI_DEFAULT_PROVIDER=dev            # dev | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_BASE_URL=                # optional (compatible gateway); default https://api.anthropic.com
OPENAI_BASE_URL=                   # optional (compatible gateway); default https://api.openai.com
AI_ENABLED=true                    # master switch; the dev provider is offline and clearly labelled provider:'dev'
AI_REQUEST_TIMEOUT_MS=20000
AI_USER_DAILY_TOKENS=60000         # per-user daily token budget (persisted)
AI_GLOBAL_DAILY_TOKENS=20000000    # platform-wide daily token budget
AI_TRANSLATIONS_PER_DAY=100        # per-user daily translation quota (cache hits are free)

# --- Search (postgres | opensearch) ---
SEARCH_BACKEND=postgres
OPENSEARCH_URL=

# --- Notifications / analytics ---
PUSH_ADAPTER=log                   # log (dev: logs only) | expo (Expo push service; needs real devices to verify)
EXPO_ACCESS_TOKEN=                 # optional Expo access token (enhanced push security)
ANALYTICS_RETENTION_DAYS=90        # raw analytics events older than this are deleted by scripts/analytics-retention.ts

# --- Observability ---
METRICS_ENABLED=true
METRICS_TOKEN=                     # if set, /metrics requires 'Authorization: Bearer <token>'; required for staging/production exposure
IP_HASH_SALT=                      # salt for hashing IPs in audit logs (required in staging/production)
SENTRY_DSN=                        # reserved: not wired yet (logs + /metrics are the current observability)
OTEL_EXPORTER_OTLP_ENDPOINT=       # reserved: not wired yet

# --- Web / Admin / Mobile (public, non-secret) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Testing / ops toggles ---
RATE_LIMIT_ENABLED=true            # tests disable this; never disable in staging/production
