# Copy to .env and adjust. Never commit real secrets.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
# development | staging | production
APP_ENV=development

# --- API ---------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the web app, used for CORS and cookie settings
WEB_ORIGIN=http://localhost:3000

# --- Database (docker compose provides these defaults) -----------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yapilapi
# Used only by the test suite; created automatically by the test setup
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/yapilapi_test

# --- Redis (rate limiting, realtime fan-out) ---------------------------
# Leave empty to fall back to in-memory (single instance only)
REDIS_URL=redis://localhost:6379

# --- Sessions ----------------------------------------------------------
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to true behind HTTPS (staging/production)
COOKIE_SECURE=false

# --- Two-step verification --------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts TOTP secrets.
# Required in production; development uses a fixed dev key when empty.
MFA_ENCRYPTION_KEY=

# --- Email (verification, password reset) -------------------------------
# "log" prints emails to the API log in development. Set to "smtp" with the
# SMTP_* values for real delivery. MISSING EXTERNAL DEPENDENCY: SMTP account.
EMAIL_TRANSPORT=log
SMTP_URL=
EMAIL_FROM="YAPILAPI <no-reply@yapilapi.local>"

# --- Media storage -------------------------------------------------------
# local = ./uploads on disk. s3 = any S3-compatible store (AWS S3, R2, MinIO,
# SeaweedFS). docker compose runs SeaweedFS on :8333 for development.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=yapilapi-media
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true

# --- Calls (WebRTC) ---------------------------------------------------------
# STUN is built in. MISSING EXTERNAL DEPENDENCY: a TURN server for users behind
# strict NATs (e.g. coturn or a hosted TURN service).
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=dev-turn-secret

# --- Push notifications ---------------------------------------------------
# Browser push (VAPID). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yapilapi.local

# --- Passkeys ------------------------------------------------------------------
# Defaults to the host of WEB_ORIGIN. Set to your real domain in production.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# --- Live video (MediaMTX in docker compose) -----------------------------------
LIVE_RTMP_URL=rtmp://localhost:1935
LIVE_HLS_BASE=http://localhost:8888
# Must match the ?secret= in infrastructure/media/mediamtx.yml
LIVE_HOOK_SECRET=dev-live-hook-secret

# --- AI (provider-agnostic gateway) -------------------------------------
# dev = deterministic local provider (no network). anthropic = Claude API.
AI_PROVIDER=dev
AI_MODEL=claude-opus-5
# MISSING EXTERNAL DEPENDENCY: API key for the chosen provider
ANTHROPIC_API_KEY=

# --- Automatic captions (speech-to-text) ---------------------------------
# none = automatic captions are unavailable (people can still write or upload
# captions). openai-compatible = any POST {url}/audio/transcriptions service
# that returns WebVTT (OpenAI, Groq, a self-hosted Whisper server).
# MISSING EXTERNAL DEPENDENCY: a speech-to-text provider.
TRANSCRIBE_PROVIDER=none
TRANSCRIBE_API_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Payments (provider abstraction) -------------------------------------
# dev = local sandbox provider. MISSING EXTERNAL DEPENDENCY: real provider keys.
PAYMENTS_PROVIDER=dev
PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- Web -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
