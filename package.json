{
  "name": "yapilapi",
  "private": true,
  "version": "0.1.0",
  "description": "YAPILAPI: your social world, one place.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @yapilapi/api",
    "dev:web": "npm run dev -w @yapilapi/web",
    "dev:admin": "npm run dev -w @yapilapi/admin",
    "build:admin": "npm run build -w @yapilapi/admin",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ai-evals": "tsx tests/ai-evals/run.ts",
    "test:load": "tsx tests/load/load.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "moments:expire": "tsx scripts/expire-moments.ts",
    "events:reminders": "tsx scripts/send-event-reminders.ts",
    "bookings:expire": "tsx scripts/expire-bookings.ts",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "commerce:maintenance": "tsx scripts/commerce-maintenance.ts",
    "creator:maintenance": "tsx scripts/creator-maintenance.ts",
    "studio:publish": "tsx scripts/studio-publish.ts",
    "live:maintenance": "tsx scripts/live-maintenance.ts",
    "ads:maintenance": "tsx scripts/ads-maintenance.ts",
    "safety:expire-enforcements": "tsx scripts/expire-enforcements.ts",
    "privacy:finalize-deletions": "tsx scripts/finalize-deletions.ts",
    "notifications:digests": "tsx scripts/send-email-digests.ts",
    "developer:webhooks": "tsx scripts/deliver-webhooks.ts",
    "analytics:retention": "tsx scripts/analytics-retention.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
